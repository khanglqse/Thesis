{
  "experiment_name": "rl_comparison",
  "num_episodes": 50,
  "eval_episodes": 10,
  "max_steps_per_episode": 3600,
  "use_gui": false,
  "train_dqn": true,
  "train_ppo": true,
  "use_fixed_time": true,
  "use_actuated": true,
  "use_adaptive": true,
  "use_random": false,
  "env_config": {
    "reward_function": "combined",
    "max_steps": 3600,
    "step_length": 1.0
  },
  "dqn_config": {
    "learning_rate": 5e-4,
    "gamma": 0.99,
    "epsilon_start": 1.0,
    "epsilon_end": 0.01,
    "epsilon_decay": 0.995,
    "target_update_freq": 1000,
    "batch_size": 128,
    "buffer_capacity": 20000,
    "device": "cpu"
  },
  "ppo_config": {
    "learning_rate": 3e-4,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.01,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "n_epochs": 10,
    "batch_size": 64,
    "device": "cpu"
  },
  "baseline_configs": {
    "fixed_time": {
      "phase_duration": 30
    },
    "actuated": {
      "threshold": 10.0,
      "min_green_time": 15,
      "max_green_time": 60,
      "yellow_time": 3
    },
    "adaptive": {
      "base_green_time": 20,
      "max_green_time": 60,
      "vehicle_threshold": 5.0,
      "congestion_threshold": 15.0
    }
  },
  "results_dir": "./results/"
}
