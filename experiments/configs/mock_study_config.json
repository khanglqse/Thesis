{
  "experiment_name": "mock_traffic_control_study",
  "use_real_sumo": false,
  "scenarios": [
    {
      "name": "single_intersection",
      "description": "Single 4-way intersection",
      "max_steps": 3600,
      "step_length": 1.0,
      "traffic_demand": 0.15,
      "reward_function": "combined"
    },
    {
      "name": "multi_intersection",
      "description": "3-intersection coordinated network",
      "max_steps": 3600,
      "step_length": 1.0,
      "traffic_demand": 0.15,
      "coordination": true,
      "reward_function": "combined"
    }
  ],
  "agent_config": {
    "type": "DQN",
    "learning_rate": 0.0005,
    "gamma": 0.99,
    "epsilon_start": 1.0,
    "epsilon_end": 0.01,
    "epsilon_decay": 0.995,
    "batch_size": 64,
    "buffer_capacity": 10000,
    "target_update_freq": 100
  },
  "training_config": {
    "num_episodes": 100,
    "eval_frequency": 10,
    "num_eval_episodes": 20,
    "max_steps_per_episode": 3600
  },
  "output_config": {
    "results_dir": "./results/mock_experiments/",
    "save_plots": true,
    "save_model": false,
    "verbose": true
  }
}
