{
  "experiment_name": "vietnam_traffic_control_study",
  "traffic_type": "vietnam",
  "description": "Traffic control optimization for Vietnamese urban traffic with high motorcycle density",
  "scenarios": [
    {
      "name": "vietnam_single_intersection",
      "description": "Single Vietnamese intersection with motorcycle lanes",
      "type": "vietnam_mock",
      "max_steps": 3600,
      "step_length": 1.0,
      "traffic_demand": 0.25,
      "motorcycle_ratio": 0.65,
      "rush_hour_multiplier": 2.5,
      "reward_function": "vietnam_optimized"
    },
    {
      "name": "vietnam_multi_intersection",
      "description": "Multi-intersection Vietnamese network",
      "type": "vietnam_mock",
      "max_steps": 3600,
      "step_length": 1.0,
      "traffic_demand": 0.25,
      "motorcycle_ratio": 0.65,
      "coordination": true,
      "rush_hour_multiplier": 2.5,
      "reward_function": "vietnam_optimized"
    }
  ],
  "controllers": [
    {
      "name": "DQN",
      "type": "RL",
      "description": "Deep Q-Network optimized for Vietnamese traffic"
    },
    {
      "name": "FixedTime",
      "type": "baseline",
      "description": "Fixed-time controller (30s cycles)",
      "phase_duration": 30
    },
    {
      "name": "Actuated",
      "type": "baseline",
      "description": "Actuated controller with motorcycle priority",
      "threshold": 8.0,
      "min_green_time": 12,
      "max_green_time": 60,
      "motorcycle_priority": 1.5
    },
    {
      "name": "Adaptive",
      "type": "baseline",
      "description": "Adaptive controller for urban traffic",
      "base_green_time": 15,
      "max_green_time": 60,
      "vehicle_threshold": 4.0,
      "congestion_threshold": 12.0
    },
    {
      "name": "Random",
      "type": "baseline",
      "description": "Random controller baseline",
      "switch_probability": 0.1
    }
  ],
  "agent_config": {
    "type": "DQN",
    "learning_rate": 0.0005,
    "gamma": 0.99,
    "epsilon_start": 1.0,
    "epsilon_end": 0.01,
    "epsilon_decay": 0.995,
    "batch_size": 64,
    "buffer_capacity": 10000,
    "target_update_freq": 100
  },
  "training_config": {
    "num_episodes": 100,
    "eval_frequency": 10,
    "num_eval_episodes": 20,
    "max_steps_per_episode": 3600
  },
  "vietnam_specific": {
    "motorcycle_ratio": 0.65,
    "rush_hours": [[6, 9], [11, 14], [16, 20]],
    "rush_hour_multiplier": 2.5,
    "motorcycle_priority_factor": 1.5,
    "congestion_penalty_exponent": 1.3,
    "urban_efficiency_factor": 1.5
  },
  "output_config": {
    "results_dir": "./results/vietnam_experiments/",
    "save_plots": true,
    "save_model": false,
    "verbose": true
  }
}
